---
interface Props {
  labels: Record<string, string>;
}

const { labels } = Astro.props;
---

<footer>
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="./index.html"><span class="brand-mark" aria-hidden="true"><span></span></span><span>WalkQuest</span></a>
      <p data-i18n="footerTagline">{labels.footerTagline}</p>
    </div>
    <div class="footer-links">
      <a href="./rules.html" data-i18n="navGuide">{labels.navGuide}</a>
      <a href="./routes.html" data-i18n="navRoutes">{labels.navRoutes}</a>
      <a href="./premium.html" data-i18n="navPremium">{labels.navPremium}</a>
      <a href="./news.html" data-i18n="navNews">{labels.navNews}</a>
      <a href="./privacy.html" data-i18n="navPrivacy">{labels.navPrivacy}</a>
      <a href="https://play.google.com/store/apps/details?id=com.walkquest" target="_blank" rel="noopener noreferrer">Google Play</a>
    </div>
    <p class="copyright">© <span id="year"></span> WalkQuest. <span data-i18n="footerRights">{labels.footerRights}</span></p>
  </div>
</footer>
