---
import LandingFooter from "../components/LandingFooter.astro";
import LandingHeader from "../components/LandingHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { PageData } from "../lib/page-data";
import { openGraphAlternateLocales } from "../lib/site";

interface Props {
  page: PageData;
}

const { page } = Astro.props;
const { head } = page;
const stylesheets = [...new Set([...head.stylesheets.filter((href) => !href.includes("pages.css")), "/pages.css?v=10"])];
const bodyScripts = page.bodyScripts.map((script) => {
  if (script.src.includes("pages-translations.js")) return { ...script, src: "/pages-translations.js?v=7" };
  if (/(^|\/)pages\.js(?:\?.*)?$/.test(script.src)) return { ...script, src: "/pages.js?v=7" };
  return script;
});
const serializeStructuredData = (value: Record<string, unknown>) => JSON.stringify(value).replaceAll("</script", "<\\/script");
const globalStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://walkquest.site/#organization",
      name: "WalkQuest",
      url: "https://walkquest.site/",
      logo: { "@type": "ImageObject", url: "https://walkquest.site/assets/walkquest-logo.svg", width: 512, height: 512 },
    },
    {
      "@type": "WebSite",
      "@id": "https://walkquest.site/#website",
      url: "https://walkquest.site/",
      name: "WalkQuest",
      publisher: { "@id": "https://walkquest.site/#organization" },
      inLanguage: page.lang,
    },
    {
      "@type": "WebPage",
      "@id": `${head.canonical}#webpage`,
      url: head.canonical,
      name: head.title,
      description: head.description,
      inLanguage: page.lang,
      isPartOf: { "@id": "https://walkquest.site/#website" },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: head.openGraph.image,
        caption: head.openGraph.imageAlt,
      },
    },
  ],
};
---

<!doctype html>
<html lang={page.lang} dir={page.dir}>
  <head>
    <meta charset={head.charset} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light" />
    <title>{head.title}</title>
    <meta name="description" content={head.description} />
    <meta name="robots" content={head.robots} />
    {head.imageCredit && <meta name="image-credit" content={head.imageCredit} />}
    {head.themeColor && <meta name="theme-color" content={head.themeColor} />}
    {head.icon && <link rel="icon" type={head.icon.type} href={head.icon.href} />}
    {head.preconnects.map((connection) => (
      <link rel="preconnect" href={connection.href} crossorigin={connection.crossOrigin ? "anonymous" : undefined} />
    ))}
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    <link rel="canonical" href={head.canonical} />
    {head.alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    <meta property="og:title" content={head.openGraph.title} />
    <meta property="og:description" content={head.openGraph.description} />
    <meta property="og:image" content={head.openGraph.image} />
    <meta property="og:image:alt" content={head.openGraph.imageAlt} />
    {head.openGraph.imageWidth && <meta property="og:image:width" content={head.openGraph.imageWidth} />}
    {head.openGraph.imageHeight && <meta property="og:image:height" content={head.openGraph.imageHeight} />}
    <meta property="og:url" content={head.openGraph.url} />
    <meta property="og:type" content={head.openGraph.type} />
    <meta property="og:site_name" content={head.openGraph.siteName} />
    <meta property="og:locale" content={head.openGraph.locale} />
    {openGraphAlternateLocales(page.lang).map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta name="twitter:card" content={head.twitter.card} />
    <meta name="twitter:title" content={head.twitter.title} />
    <meta name="twitter:description" content={head.twitter.description} />
    <meta name="twitter:image" content={head.twitter.image} />
    <meta name="twitter:image:alt" content={head.openGraph.imageAlt} />
    <meta name="twitter:url" content={head.twitter.url} />
    {head.inlineStyles.map((styles) => <style set:html={styles} />)}
    <script type="application/ld+json" set:html={serializeStructuredData(globalStructuredData)} />
    {head.structuredData.map((entry) => <script type="application/ld+json" set:html={serializeStructuredData(entry)} />)}
    {head.scripts.map((script) => <script src={script.src} defer={script.defer}></script>)}
  </head>
  <body {...page.bodyAttributes}>
    <a class="skip-link" href="#main">{page.labels.skipLink}</a>
    {page.chrome === "site" && <SiteHeader labels={page.labels} lang={page.lang} />}
    {page.chrome === "landing" && <LandingHeader labels={page.labels} />}
    <slot />
    {page.chrome === "site" && <SiteFooter labels={page.labels} lang={page.lang} />}
    {page.chrome === "landing" && <LandingFooter labels={page.labels} />}
    {bodyScripts.map((script) => <script src={script.src} defer={script.defer}></script>)}
  </body>
</html>
