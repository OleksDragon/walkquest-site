---
interface Props {
  labels: Record<string, string>;
}

const { labels } = Astro.props;
---

<footer>
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"><span></span></span><span>WalkQuest</span></a>
      <p data-i18n="footerText">{labels.footerTagline}</p>
    </div>
    <div class="footer-links">
      <a href="./rules.html" data-i18n="siteGuide">{labels.navGuide}</a>
      <a href="./routes.html" data-i18n="siteRoutes">{labels.navRoutes}</a>
      <a href="./premium.html" data-i18n="sitePremium">{labels.navPremium}</a>
      <a href="./news.html" data-i18n="siteNews">{labels.navNews}</a>
      <a href="./privacy.html" data-i18n="privacy">{labels.navPrivacy}</a>
      <a href="mailto:digitalstudiogold@gmail.com" data-i18n="contact">{labels.contact}</a>
      <a href="https://play.google.com/store/apps/details?id=com.walkquest" target="_blank" rel="noopener noreferrer">Google Play</a>
    </div>
    <p class="copyright">© <span id="year"></span> WalkQuest. <span data-i18n="rights">{labels.footerRights}</span></p>
  </div>
</footer>
