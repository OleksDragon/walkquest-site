---
import LegacyLayout from "../../layouts/LegacyLayout.astro";
import RoutePage from "../../components/RoutePage.astro";
import { getLegacyPage, listLegacyPages } from "../../lib/legacy-pages";
import { getRoutePage, isRouteFile } from "../../lib/route-pages";

export function getStaticPaths() {
  return listLegacyPages()
    .filter((file) => file.includes("/"))
    .map((file) => {
      const [lang, name] = file.split("/");
      return {
        params: { lang, page: name.replace(/\.html$/, "") },
        props: { file },
      };
    });
}

const route = isRouteFile(Astro.props.file) ? getRoutePage(Astro.props.file) : null;
const page = route ? null : getLegacyPage(Astro.props.file);
---

{route ? <RoutePage route={route} /> : <LegacyLayout page={page!} />}
