---
import type { InlineNode } from "../lib/page-data";

interface Props {
  nodes: InlineNode[];
}

const { nodes } = Astro.props;
const needsSpace = (node: InlineNode, index: number) => index > 0 && !/^[.,;:!?)]/.test(node.text);
---

<>{nodes.map((node, index) => (
  <>{needsSpace(node, index) && " "}{node.type === "strong" ? (
    <strong>{node.text}</strong>
  ) : node.type === "link" ? (
    <a href={node.href} target={node.external ? "_blank" : undefined} rel={node.external ? "noopener noreferrer" : undefined}>
      {node.strong ? <strong>{node.text}</strong> : node.text}
    </a>
  ) : node.text}</>
))}</>
