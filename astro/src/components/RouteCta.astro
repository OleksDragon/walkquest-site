---
import GooglePlayButton from "./GooglePlayButton.astro";

interface Props {
  copyHtml: string;
  playLabel: string;
}

const { copyHtml, playLabel } = Astro.props;
---

<section class="page-cta">
  <div class="shell page-cta-card">
    <div><Fragment set:html={copyHtml} /></div>
    <GooglePlayButton label={playLabel} light />
  </div>
</section>
