---
import GooglePlayButton from "./GooglePlayButton.astro";
import type { PageData } from "../lib/page-data";

interface Props { page: PageData; }
const { page } = Astro.props;
if (!page.news) throw new Error(`Missing news content for ${page.relativePath}`);
const c = page.news.copy;
const assetPrefix = page.relativePath.includes("/") ? "../" : "./";
const localeBase = page.lang === "en" ? "" : `/${page.lang === "zh-CN" ? "zh-cn" : page.lang === "pt-BR" ? "pt-br" : page.lang}`;
const nextStories = [
  { href: "./release-notes.html", image: "article-release.webp", alt: "releaseCardAlt", tag: "releaseTag", title: "newsNext1Title", text: "newsNext1Text" },
  { href: "./europe-explorer.html", image: "article-europe.webp", alt: "europeCardAlt", tag: "europeTag", title: "newsNext2Title", text: "newsNext2Text" },
  { href: "./health-connect-guide.html", image: "article-health-connect.webp", alt: "healthCardAlt", tag: "healthTag", title: "newsNext3Title", text: "newsNext3Text" },
];
const journalSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${page.head.canonical}#journal`,
  url: page.head.canonical,
  name: c.newsTitle,
  description: page.head.description,
  inLanguage: page.lang,
  isPartOf: { "@id": "https://walkquest.site/#website" },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: "https://walkquest.site/assets/news-hero-v3.webp",
    caption: c.newsHeroAlt,
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: 4,
    itemListElement: [
      { "@type": "ListItem", position: 1, url: `https://walkquest.site${localeBase}/sharing-achievements.html`, name: c.shareTitle },
      ...nextStories.map((story, index) => ({
        "@type": "ListItem",
        position: index + 2,
        url: `https://walkquest.site${localeBase}/${story.href.slice(2)}`,
        name: c[story.title],
      })),
    ],
  },
};
const serializeSchema = JSON.stringify(journalSchema).replaceAll("</script", "<\\/script");
---

<main id="main">
  <script type="application/ld+json" set:html={serializeSchema} />
  <section class="page-hero"><div class="shell page-hero-grid">
    <div class="page-hero-copy"><span class="section-kicker" data-i18n="newsEyebrow">{c.newsEyebrow}</span><h1 data-i18n="newsTitle">{c.newsTitle}</h1><p data-i18n="newsDesc">{c.newsDesc}</p><div class="page-hero-badges"><span data-i18n="newsBadgeUpdates">{c.newsBadgeUpdates}</span><span data-i18n="newsBadgeRoutes">{c.newsBadgeRoutes}</span><span data-i18n="newsBadgeGuides">{c.newsBadgeGuides}</span></div></div>
    <div class="page-hero-media"><img src={`${assetPrefix}assets/news-hero-v3.webp`} width="1279" height="720" alt={c.newsHeroAlt} data-i18n-alt="newsHeroAlt" fetchpriority="high" decoding="async" /></div>
  </div></section>
  <section class="page-section"><div class="shell">
    <div class="page-heading"><span class="section-kicker" data-i18n="newsLatestKicker">{c.newsLatestKicker}</span><h2 data-i18n="newsLatestTitle">{c.newsLatestTitle}</h2><p class="section-intro" data-i18n="newsLatestText">{c.newsLatestText}</p></div>
    <div class="news-grid">
      <a class="news-card featured news-card-link" href="./sharing-achievements.html"><img src={`${assetPrefix}assets/article-sharing.webp`} width="1279" height="720" loading="lazy" decoding="async" alt={c.shareHeroAlt} data-i18n-alt="shareHeroAlt" /><div class="news-card-copy"><span class="news-tag" data-i18n="shareTag">{c.shareTag}</span><time class="news-date" datetime="2026-10-03" data-i18n="shareDate">{c.shareDate}</time><h3 data-i18n="shareTitle">{c.shareTitle}</h3><p data-i18n="shareLead">{c.shareLead}</p><span class="news-card-action" data-i18n="readArticle">{c.readArticle}</span></div></a>
      <a class="news-card news-card-link" href="./routes.html"><span class="news-tag" data-i18n="news2Tag">{c.news2Tag}</span><time class="news-date" datetime="2026-09-28" data-i18n="news2Date">{c.news2Date}</time><h3 data-i18n="news2Title">{c.news2Title}</h3><p data-i18n="news2Text">{c.news2Text}</p><span class="news-card-action" data-i18n="navRoutes">{page.labels.navRoutes} →</span></a>
      <a class="news-card news-card-link" href="./rules.html"><span class="news-tag" data-i18n="news3Tag">{c.news3Tag}</span><time class="news-date" datetime="2026-09-20" data-i18n="news3Date">{c.news3Date}</time><h3 data-i18n="news3Title">{c.news3Title}</h3><p data-i18n="news3Text">{c.news3Text}</p><span class="news-card-action" data-i18n="navGuide">{page.labels.navGuide} →</span></a>
    </div>
  </div></section>
  <section class="page-section dark journal-section"><div class="shell">
    <div class="page-heading center"><span class="section-kicker" data-i18n="newsNextKicker">{c.newsNextKicker}</span><h2 data-i18n="newsNextTitle">{c.newsNextTitle}</h2><p class="section-intro" data-i18n="newsNextText">{c.newsNextText}</p></div>
    <div class="next-grid">{nextStories.map((story) => <a class="next-card" href={story.href}><img src={`${assetPrefix}assets/${story.image}`} width="1279" height="720" loading="lazy" decoding="async" alt={c[story.alt]} data-i18n-alt={story.alt} /><div class="next-card-copy"><span class="news-tag" data-i18n={story.tag}>{c[story.tag]}</span><h3 data-i18n={story.title}>{c[story.title]}</h3><p data-i18n={story.text}>{c[story.text]}</p><span class="article-link-label" data-i18n="readArticle">{c.readArticle}</span></div></a>)}</div>
  </div></section>
  <section class="page-cta"><div class="shell page-cta-card"><div><h2 data-i18n="newsCtaTitle">{c.newsCtaTitle}</h2><p data-i18n="newsCtaText">{c.newsCtaText}</p></div><GooglePlayButton label={c.playSmall} /></div></section>
</main>
