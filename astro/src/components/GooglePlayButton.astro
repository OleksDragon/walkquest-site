---
interface Props {
  label: string;
  light?: boolean;
}

const { label, light = false } = Astro.props;
---

<a class:list={["play-button", { "light-button": light }]} href="https://play.google.com/store/apps/details?id=com.walkquest" target="_blank" rel="noopener noreferrer">
  <svg viewBox="0 0 32 36" aria-hidden="true">
    <path fill="currentColor" d="M2.4 1.2A4 4 0 0 0 1 4.3v27.4a4 4 0 0 0 1.4 3.1L18 18 2.4 1.2Zm18.2 19.5-4 4.3 9.2 5.2a3.4 3.4 0 0 0 4.9-2.8c0-1.2-.7-2.3-1.7-2.9l-8.4-3.8Zm8.4-9.2-8.4 3.8-4-4.3 9.2-5.2a3.4 3.4 0 0 1 4.9 2.8c0 1.2-.7 2.3-1.7 2.9ZM3.9 35.6l14.2-8.1-4-4.3L3.9 35.6Zm0-35.2 10.2 12.4 4-4.3L3.9.4Z" />
  </svg>
  <span><small data-i18n="playSmall">{label}</small><strong>Google Play</strong></span>
</a>
