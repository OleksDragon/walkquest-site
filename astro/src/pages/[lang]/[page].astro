---
import PageLayout from "../../layouts/PageLayout.astro";
import RoutePage from "../../components/RoutePage.astro";
import { getPageData, listPageFiles } from "../../lib/page-data";
import { getRoutePage, isRouteFile } from "../../lib/route-pages";

export function getStaticPaths() {
  return listPageFiles()
    .filter((file) => file.includes("/"))
    .map((file) => {
      const [lang, name] = file.split("/");
      return {
        params: { lang, page: name.replace(/\.html$/, "") },
        props: { file },
      };
    });
}

const route = isRouteFile(Astro.props.file) ? getRoutePage(Astro.props.file) : null;
const page = route ? null : getPageData(Astro.props.file);
---

{route ? <RoutePage route={route} /> : <PageLayout page={page!} />}
