---
import { SOCIAL_LINKS } from "../config/socialLinks";

interface Props {
  labels: Record<string, string>;
  lang: string;
}

const { labels, lang } = Astro.props;
const termsLabels: Record<string, string> = {
  en: "Terms of Use", uk: "Умови використання", ru: "Условия использования", es: "Términos de uso",
  de: "Nutzungsbedingungen", fr: "Conditions d’utilisation", pl: "Warunki korzystania", pt: "Termos de Utilização",
  it: "Termini di utilizzo", tr: "Kullanım Koşulları", ja: "利用規約", ko: "이용약관",
  "zh-CN": "使用条款", ar: "شروط الاستخدام", hi: "उपयोग की शर्तें", "pt-BR": "Termos de Uso",
};
---

<footer>
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"><span></span></span><span>WalkQuest</span></a>
      <p data-i18n="footerText">{labels.footerTagline}</p>
    </div>
    <div class="footer-links">
      <a href="./rules.html" data-i18n="siteGuide">{labels.navGuide}</a>
      <a href="./routes.html" data-i18n="siteRoutes">{labels.navRoutes}</a>
      <a href="./premium.html" data-i18n="sitePremium">{labels.navPremium}</a>
      <a href="./news.html" data-i18n="siteNews">{labels.navNews}</a>
      <a href="./privacy.html" data-i18n="privacy">{labels.navPrivacy}</a>
      <a href="./terms.html">{termsLabels[lang] ?? termsLabels.en}</a>
      <a href="mailto:digitalstudiogold@gmail.com" data-i18n="contact">{labels.contact}</a>
      <a href="https://play.google.com/store/apps/details?id=com.walkquest" target="_blank" rel="noopener noreferrer">Google Play</a>
    </div>
    <nav class="footer-social-links" aria-label="WalkQuest social media">
      <a href={SOCIAL_LINKS.youtube.url} target="_blank" rel="me noopener noreferrer"><span aria-hidden="true">▶</span>YouTube</a>
      <a href={SOCIAL_LINKS.tiktok.url} target="_blank" rel="me noopener noreferrer"><span aria-hidden="true">♪</span>TikTok</a>
    </nav>
    <p class="copyright">© <span id="year"></span> WalkQuest. <span data-i18n="rights">{labels.footerRights}</span></p>
  </div>
</footer>
